# Copy to apps/api/.env and fill in. Never commit the filled file.
JAMASP_DATABASE_URL=postgresql+asyncpg://jamasp:jamasp@localhost:5432/jamasp
JAMASP_REDIS_URL=redis://localhost:6379/0
JAMASP_ENVIRONMENT=development

# Both must be 32 random bytes, urlsafe-base64 encoded:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
JAMASP_SECRET_KEY=
JAMASP_JWT_SECRET=

# LLM providers (all OpenAI-compatible)
JAMASP_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
JAMASP_OPENROUTER_API_KEY=

JAMASP_GAPGPT_BASE_URL=https://api.gapgpt.app/v1
JAMASP_GAPGPT_API_KEY=

JAMASP_LOCAL_BASE_URL=http://localhost:11434/v1
JAMASP_LOCAL_API_KEY=
