# Copy to apps/api/.env and fill in. Never commit the filled file.
AGAH_DATABASE_URL=postgresql+asyncpg://agah:agah@localhost:5432/agah
AGAH_REDIS_URL=redis://localhost:6379/0
AGAH_ENVIRONMENT=development

# Both must be 32 random bytes, urlsafe-base64 encoded:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AGAH_SECRET_KEY=
AGAH_JWT_SECRET=

# LLM providers (all OpenAI-compatible)
AGAH_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGAH_OPENROUTER_API_KEY=

AGAH_GAPGPT_BASE_URL=https://api.gapgpt.app/v1
AGAH_GAPGPT_API_KEY=

AGAH_LOCAL_BASE_URL=http://localhost:11434/v1
AGAH_LOCAL_API_KEY=
